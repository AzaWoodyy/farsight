{
  "name": "lol-esports-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "bun run data:pull && next build && bun run size",
    "start": "next start",
    "lint": "oxlint",
    "data:fetch": "bun scripts/data/fetch.ts",
    "data:build": "bun scripts/data/build.ts",
    "data:package": "bun scripts/data/package.ts",
    "data:pull": "bun scripts/data/pull.ts",
    "data:sync": "bun scripts/data/sync.ts",
    "size": "bun scripts/size.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "ask": "bun scripts/ask.ts",
    "eval": "bun scripts/eval.ts",
    "test": "bun test scripts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7",
    "aws4fetch": "1.0.20",
    "botid": "1.5.12",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "1.93.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
