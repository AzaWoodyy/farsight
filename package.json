{
  "name": "farsight",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "bun run data:pull && bun run lab:build && next build && bun run size",
    "start": "next start",
    "lint": "oxlint",
    "data:fetch": "bun scripts/data/fetch.ts",
    "data:build": "bun scripts/data/build.ts",
    "data:package": "bun scripts/data/package.ts",
    "data:pull": "bun scripts/data/pull.ts",
    "data:sync": "bun scripts/data/sync.ts",
    "size": "bun scripts/size.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "ask": "bun scripts/ask.ts",
    "lab:build": "bun scripts/lab/build.ts",
    "eval": "bun scripts/eval.ts",
    "test": "bun test scripts",
    "verify": "bun run lint --deny-warnings && bun run typecheck && python3 scripts/ci/test.py && bun run data:pull && bun run eval --deterministic --strict --exclude-tags=timeline && bun run build"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.178",
    "@langfuse/otel": "6.1.1",
    "@langfuse/tracing": "6.1.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/functions": "3.11.3",
    "ai": "7.0.174",
    "aws4fetch": "1.0.20",
    "botid": "1.5.13",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.94.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.94.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vercel": "65.17.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "js-yaml": "4.3.2",
    "smol-toml": "1.9.1",
    "tar": "7.5.23"
  }
}
