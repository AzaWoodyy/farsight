# The Vercel CLI does not read .gitignore: list here what `vercel deploy`
# must never upload. Secrets first, then the local data (the build downloads
# the database with data:pull).
.env
.env.*
!.env.example
/data/
/coverage/
*.pem
*.tsbuildinfo
next-env.d.ts
# Local only: the CI snapshot cache (scripts/ci/data.ts) and working notes.
/.ci-data/
/plans/
