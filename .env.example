# Copy to .env (never commit .env). Every variable is optional.

# --- LLM (OpenRouter) ---------------------------------------------------------
# Without a key the agent runs fully deterministic (rules level of every step).
# With a key, the LLM is only called when the rules are not confident enough:
# entity extraction, text-to-SQL fallback, SQL repair, summary sentence.
# Use a key with a spending cap.
OPENROUTER_API_KEY=
# Model id on OpenRouter (default: anthropic/claude-haiku-5.5).
OPENROUTER_MODEL=

# --- Data ---------------------------------------------------------------------
# SQLite file built by data:build, opened read-only by the app (default: data/lol.sqlite).
DATABASE_PATH=
# Delay between Leaguepedia requests during data:fetch, in ms (default 2500, minimum 2000).
LEAGUEPEDIA_DELAY_MS=
# User-Agent sent to Leaguepedia (default: a generic project identifier).
LEAGUEPEDIA_USER_AGENT=

# --- Published database (data:pull) -------------------------------------------
# Fine-grained GitHub token, read-only on this repository (Contents: Read).
# Required on Vercel, optional locally (a local data:build is kept as is).
DATA_GITHUB_TOKEN=
# Pin a release tag (e.g. data-20261113). Default: newest release matching the schema.
DATA_RELEASE=
# owner/name of the repository holding the releases (default: AzaWoodyy/lol-esports-agent).
DATA_REPO=
# GitHub API base URL (default https://api.github.com).
DATA_GITHUB_API=
