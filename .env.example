# Copy to .env (never commit .env). Every variable is optional.

# --- LLM provider -------------------------------------------------------------
# none (default): fully deterministic graph (rule-based understanding,
# templated summary). anthropic | openai: LLM for entity extraction, SQL repair
# and the summary sentence.
LLM_PROVIDER=none
# Model id for the chosen provider (required for openai).
LLM_MODEL=
# Key for the chosen provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (OpenRouter, Ollama, LM Studio, ...).
OPENAI_BASE_URL=

# --- Data ---------------------------------------------------------------------
# SQLite cache location (default: data/lol.sqlite).
DATABASE_PATH=
# Delay between Leaguepedia requests during data:fetch, in ms (default 2500, minimum 2000).
LEAGUEPEDIA_DELAY_MS=
# User-Agent sent to Leaguepedia (default: a generic project identifier).
LEAGUEPEDIA_USER_AGENT=
